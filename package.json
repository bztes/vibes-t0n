{
	"name": "@bztes/vibes-t0n",
	"version": "0.1.0",
	"description": "Translations for Svelte (and other Vite frameworks) by writing t`texts` in the source language",
	"keywords": [
		"svelte",
		"sveltekit",
		"vite-plugin",
		"i18n",
		"translation"
	],
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bztes/vibes-t0n.git"
	},
	"homepage": "https://github.com/bztes/vibes-t0n#readme",
	"bugs": {
		"url": "https://github.com/bztes/vibes-t0n/issues"
	},
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		},
		"./sveltekit": {
			"types": "./dist/sveltekit.d.ts",
			"default": "./dist/sveltekit.js"
		},
		"./studio": {
			"types": "./dist/studio/server.d.ts",
			"default": "./dist/studio/server.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && vite build -c vite.studio.config.ts",
		"dev": "tsc -p tsconfig.build.json --watch",
		"dev:studio": "vite -c vite.studio.config.ts",
		"check": "tsc --noEmit && svelte-check --tsconfig src/studio/ui/tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"prepare": "pnpm build",
		"prepublishOnly": "pnpm check && pnpm build",
		"changeset": "changeset",
		"studio": "node dist/cli.js studio"
	},
	"dependencies": {
		"magic-string": "^1.4.5"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"svelte": "^5.57.0",
		"vite": "^8.0.0"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"bin": {
		"t0n": "./dist/cli.js"
	}
}
